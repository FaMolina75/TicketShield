APP_NAME=TicketShield
APP_ENV=production
APP_KEY=            # php artisan key:generate --show
APP_DEBUG=false     # NUNCA true en producción
APP_URL=https://tu-dominio.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=ticket
DB_USERNAME=ticket_app      # usuario con permisos mínimos, NO root
DB_PASSWORD=                # contraseña larga y aleatoria

SESSION_DRIVER=file          # NO uses "database": la tabla `sessions` del proyecto es la de sesiones de eventos (conflicto). Con varias instancias usa redis
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file           # mejor redis si hay varias instancias (los límites de peticiones se comparten)
QUEUE_CONNECTION=sync

CORS_ALLOWED_ORIGINS=https://tu-dominio.com

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"
